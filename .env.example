# 企查查开放平台 API 密钥
# 复制此文件为 .env 并填入真实密钥
# 获取方式：https://openapi.qcc.com → 注册 → 企业认证 → 账号安全 → AppKey/SecretKey

QCC_APP_KEY=your_app_key_here
QCC_SECRET_KEY=your_secret_key_here

# 海外部署时，设置国内 SCF 中继地址（解决数据不能出境问题）
# 部署方式：scripts/qcc_relay_scf.py → 腾讯云 SCF（国内区域）
# QCC_RELAY_URL=https://qcc-relay-xxx.gz.scf.tencentcs.com
